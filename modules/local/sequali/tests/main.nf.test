nextflow_process {

    name "Test Process SEQUALI"
    script "../main.nf"
    process "SEQUALI"

    tag "modules"
    tag "modules_local"
    tag "sequali"

    test("nanopore - fastq") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'NANOPORE_BARCODE01',
                    fastq: file("${projectDir}/assets/reads/sample_ont_part1.fastq", checkIfExists: true)
                ))
                input[1] = ''
                """
            }
        }

        then {
            def report = process.out[0][0]
            assertAll(
                { assert process.success },
                // The HTML report embeds the run time, so its name is snapshotted
                // together with the read metrics from the JSON summary.
                { assert snapshot(
                    report.id,
                    path(report.html).fileName.toString(),
                    path(report.json).fileName.toString(),
                    path(report.json).json.summary
                ).match() }
            )
        }
    }

    test("nanopore - fastq - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'NANOPORE_BARCODE01',
                    fastq: file("${projectDir}/assets/reads/sample_ont_part1.fastq", checkIfExists: true)
                ))
                input[1] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
