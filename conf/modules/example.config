/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    conf/modules/example.config — EXAMPLE tool arguments
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    One config file per logical stage. `withName:` selectors are PLAIN process
    names (never WORKFLOW:SUBWORKFLOW:PROCESS). Modules read tuning via ext.args
    so they stay parameter-agnostic. Publishing is declared in the output block
    of main.nf.
*/

process {
    withName: EXAMPLE {
        ext.args   = ''
        ext.prefix = { "${meta.id}" }
    }
}
