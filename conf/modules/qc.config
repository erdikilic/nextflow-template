/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    conf/modules/qc.config — SEQUALI (read QC)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SEQUALI is the nf-core/sequali module. Its container is a full image URL
    because nf-core modules name their registry explicitly. Sequali detects the
    read format itself, so ext.args is empty; see `sequali --help` for tuning
    (e.g. --adapter-file, --overrepresentation-threshold-fraction).
*/

process {
    withName: SEQUALI {
        ext.args   = ''
        ext.prefix = { "${meta.id}" }
    }
}
