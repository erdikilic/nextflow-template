/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    conf/test.config — minimal CI test profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Usage: nextflow run . -profile test,docker --outdir <dir>
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal dataset to exercise the pipeline end-to-end'

    max_cpus   = 2
    max_memory = 6.GB

    input  = "${projectDir}/assets/samplesheet.csv"
    outdir = 'results_test'
}
