nextflow_pipeline {

    name "Minimal workflow test (stub)"
    script "main.nf"

    tag "workflow"

    test("test profile runs end-to-end in stub mode") {

        options "-stub"

        when {
            // The bundled samplesheet lists its FASTQs relative to the repository
            // root, the usual launch directory. nf-test launches from its own test
            // directory, so the test runs on a copy with absolute paths.
            def samplesheet = new File("${launchDir}/samplesheet.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = new File("${baseDir}/assets/samplesheet.csv").readLines()
                .collect { line -> line.replace(',assets/', ",${baseDir}/assets/") }
                .join('\n') + '\n'

            params {
                input  = samplesheet.toString()
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // 3 samplesheet rows -> 2 samples: NANOPORE_BARCODE01 arrives as
                // two FASTQs and is merged into one.
                { assert path("$outputDir/reads").list().findAll { f -> f.fileName.toString().endsWith('.merged.fastq.gz') }.size() == 2 },
                { assert path("$outputDir/example").list().size() == 2 },
                // Sequali: an HTML and a JSON report per sample, plus the index.
                { assert path("$outputDir/qc/sequali").list().size() == 5 },
                { assert path("$outputDir/qc/sequali/index.csv").readLines()[0] == 'sample,platform,html,json' },
                // The reads index is a samplesheet in the input format.
                { assert path("$outputDir/reads/samplesheet.csv").readLines().size() == 3 },
                { assert path("$outputDir/reads/samplesheet.csv").readLines()[0] == 'sample,platform,fastq' },
                { assert path("$outputDir/workflow_info/versions.yml").exists() }
            )
        }
    }
}
