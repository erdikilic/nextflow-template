/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nextflow.config — defaults, manifest, and profiles
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

plugins {
    id 'nf-schema@3.0.0'   // --help and the parameter summary, from nextflow_schema.json
}

// Parameters the configuration reads. Parameters read only by the workflow
// script are declared with their types in the params block of main.nf.
params {
    outdir           = 'results'
    publish_dir_mode = 'copy'

    // Set by the test profiles and shown in the run summary.
    config_profile_name        = null
    config_profile_description = null

    // Per-task resource limits (process.resourceLimits in conf/base.config).
    // Raise them on a larger host: --max_cpus 64 --max_memory 256.GB
    max_cpus   = 14
    max_memory = 30.GB
}

// ---------------------------------------------------------------------------
// Container registry — bare image names in modules resolve against this.
// ---------------------------------------------------------------------------
docker.registry    = 'quay.io'
podman.registry    = 'quay.io'
singularity.registry = 'quay.io'
apptainer.registry = 'quay.io'

profiles {
    debug {
        cleanup = false
        process.beforeScript = 'echo $HOSTNAME'
    }
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g) --shm-size=8g'
        conda.enabled       = false
        singularity.enabled = false
        apptainer.enabled   = false
        podman.enabled      = false
    }
    apptainer {
        apptainer.enabled   = true
        apptainer.autoMounts = true
        docker.enabled      = false
        conda.enabled       = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled      = false
        conda.enabled       = false
    }
    podman {
        podman.enabled      = true
        podman.runOptions   = '--shm-size=8g'
        docker.enabled      = false
        conda.enabled       = false
    }
    conda {
        conda.enabled       = true
        docker.enabled      = false
        singularity.enabled = false
        apptainer.enabled   = false
    }

    // --- Hardware tiers (set the per-task resource limits) ---
    laptop      { params.max_cpus = 6;  params.max_memory = 12.GB }
    workstation { params.max_cpus = 16; params.max_memory = 60.GB }
    server      { params.max_cpus = 32; params.max_memory = 120.GB }
    hpc         { params.max_cpus = 64; params.max_memory = 256.GB }

    // --- Test data profiles ---
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
}

// Workflow outputs: the root directory and copy mode for the output block in
// main.nf.
outputDir            = params.outdir
workflow.output.mode = params.publish_dir_mode

// nf-schema: settings for paramsHelp() and paramsSummaryLog(). monochrome_logs
// is declared in the params block of main.nf.
validation {
    monochromeLogs = params.monochrome_logs ?: false
    help {
        fullParameter       = 'help_full'
        showHiddenParameter = 'show_hidden'
    }
}

// Base resource labels and per-module settings. Included after the profiles so
// the resource limits read the max_cpus / max_memory a profile or the CLI sets.
includeConfig 'conf/base.config'
includeConfig 'conf/modules/prepare_reads.config'
includeConfig 'conf/modules/qc.config'
includeConfig 'conf/modules/example.config'

// Provenance / reporting. Each file is written to workflow_info/ under
// outputDir (= --outdir), next to the collated tool versions.
timeline { enabled = true; directory = 'workflow_info'; file = 'execution_timeline.html'; overwrite = true }
report   { enabled = true; directory = 'workflow_info'; file = 'execution_report.html';   overwrite = true }
trace    { enabled = true; directory = 'workflow_info'; file = 'execution_trace.txt';      overwrite = true }
dag      { enabled = true; directory = 'workflow_info'; file = 'workflow_dag.html';        overwrite = true }

manifest {
    name            = 'nextflow-template'
    contributors    = [
        [
            name: 'Erdi Kılıç',
            github: 'https://github.com/erdikilic',
            contribution: ['author', 'maintainer'],
        ],
    ]
    homePage        = 'https://github.com/erdikilic/nextflow-template'
    description     = 'A state-of-the-art Nextflow DSL2 workflow template.'
    mainScript      = 'main.nf'
    nextflowVersion = '>=26.10.4'
    version         = '1.0.0dev'
    license         = 'Apache-2.0'
}
