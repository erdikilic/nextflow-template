nextflow_process {

    name "Test Process HANDLE_DATA"
    script "../main.nf"
    process "HANDLE_DATA"

    tag "modules"
    tag "modules_local"
    tag "handle_data"

    test("nanopore - multiple fastq") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'NANOPORE_BARCODE01',
                    reads: [
                        file("${projectDir}/assets/reads/sample_ont_part1.fastq", checkIfExists: true),
                        file("${projectDir}/assets/reads/sample_ont_part2.fastq", checkIfExists: true),
                    ]
                ))
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("pacbio - single fastq") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'PACBIO_HIFI',
                    reads: [ file("${projectDir}/assets/reads/sample_pacbio.fastq", checkIfExists: true) ]
                ))
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("nanopore - multiple fastq - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'NANOPORE_BARCODE01',
                    reads: [
                        file("${projectDir}/assets/reads/sample_ont_part1.fastq", checkIfExists: true),
                        file("${projectDir}/assets/reads/sample_ont_part2.fastq", checkIfExists: true),
                    ]
                ))
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
