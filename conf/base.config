/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    conf/base.config — default resource requests per process label
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Labels state what a task asks for; `resourceLimits` states what the host can
    give. Nextflow lowers every request to the limits, so a label never needs to
    know the machine it runs on. Memory grows with each retry and stops at the
    memory limit.

    The limits come from --max_cpus / --max_memory, which the laptop/workstation/
    server/hpc profiles set per host class and the command line overrides.
    Default tiers:
      process_single (1 CPU, 4GB)   process_low    (4 CPU, 8GB)  — e.g. HANDLE_DATA
      process_medium (8 CPU, 16GB)  process_high  (12 CPU, 24GB)
*/

process {
    resourceLimits = [cpus: params.max_cpus, memory: params.max_memory]

    cpus   = 4
    memory = { 8.GB * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = 1
        memory = { 4.GB * task.attempt }
    }
    withLabel: process_low {
        cpus   = 4
        memory = { 8.GB * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 8
        memory = { 16.GB * task.attempt }
    }
    withLabel: process_high {
        cpus   = 12
        memory = { 24.GB * task.attempt }
    }
    withLabel: error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 3
    }
}
