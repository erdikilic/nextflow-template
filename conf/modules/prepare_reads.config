/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    conf/modules/prepare_reads.config — HANDLE_DATA (input normalisation)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    withName: HANDLE_DATA {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/reads" },
            mode: params.publish_dir_mode,
            pattern: '*.merged.fastq.gz',
        ]
    }
}
