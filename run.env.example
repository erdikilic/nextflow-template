# Copy to run.env and `source run.env` (or use with run.sh). Never commit run.env.
# Container engine profile: docker | apptainer | singularity | podman | conda
export PROFILE=docker

# Default output directory
export OUTDIR=results

# Example: point Nextflow at a scratch work dir on a fast disk
# export NXF_WORK=/scratch/$USER/nextflow-work
