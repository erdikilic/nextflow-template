config {
    testsDir "."
    workDir ".nf-test"
    configFile "tests/nextflow.config"
    profile "test"

    // Component tests live next to the component, so the whole repository is
    // scanned. Exclude directories that vendor third-party test suites, which
    // would otherwise be collected and executed as if they were our own.
    ignore ".pixi/**", ".venv/**", "work/**"

    // sanitizeOutput() and the path helpers used by the component snapshots.
    plugins {
        load "nft-utils@1.2.0"
    }
}
