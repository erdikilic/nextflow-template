/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    conf/modules/example.config — per-process publishDir + ext.args
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    One config file per logical stage. `withName:` selectors are PLAIN process
    names (never WORKFLOW:SUBWORKFLOW:PROCESS). Modules read tuning via ext.args
    so they stay parameter-agnostic.
*/

process {
    withName: EXAMPLE {
        ext.args   = ''
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/example" },
            mode: params.publish_dir_mode,
            pattern: '*.linecount.txt',
        ]
    }
}
