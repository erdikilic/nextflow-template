nextflow_workflow {

    name "Test Workflow READS:PREPARE"
    script "../main.nf"
    workflow "PREPARE"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "reads/prepare"

    test("a multi-file and a single-file sample each become one FASTQ") {

        when {
            workflow {
                """
                input[0] = channel.of(
                    record(
                        id: 'ONT_BARCODE01',
                        platform: 'ont_r10',
                        reads: [
                            file("${projectDir}/assets/reads/sample_ont_part1.fastq", checkIfExists: true),
                            file("${projectDir}/assets/reads/sample_ont_part2.fastq", checkIfExists: true),
                        ]
                    ),
                    record(
                        id: 'HIFI_SAMPLE01',
                        platform: 'pacbio_hifi',
                        reads: [ file("${projectDir}/assets/reads/sample_pacbio.fastq", checkIfExists: true) ]
                    )
                )
                input[1] = ''
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // The merged FASTQ replaces the list of reads in each record.
                { assert snapshot(workflow.out[0].sort { s -> s.id }).match() }
            )
        }
    }
}
