nextflow_workflow {

    name "Test Workflow INPUT_CHECK"
    script "../main.nf"
    workflow "INPUT_CHECK"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "input_check"

    test("nanopore + pacbio samplesheet groups multi-file samples") {

        when {
            workflow {
                """
                input[0] = file("${projectDir}/assets/samplesheet.csv", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // 3 rows -> 2 samples: NANOPORE_BARCODE01 arrives as two FASTQs.
                { assert workflow.out[0].size() == 2 },
                // Snapshot names only: the samplesheet holds paths outside the
                // work dir, whose absolute form differs per machine.
                { assert snapshot(
                    workflow.out[0].collect { meta, reads -> [meta, reads.collect { r -> file(r).name }] }
                ).match() }
            )
        }
    }
}
