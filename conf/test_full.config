/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    conf/test_full.config — full-size test profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Point this at a realistic dataset for release/regression testing.
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full-size dataset to test the pipeline before release'

    // TODO: replace with a full-size samplesheet (local path or remote URL).
    input  = "${projectDir}/assets/samplesheet.csv"
    outdir = 'results_test_full'
}
