nextflow_process {

    name "Test Process EXAMPLE"
    script "../main.nf"
    process "EXAMPLE"

    tag "modules"
    tag "modules_local"
    tag "example"

    test("nanopore - fastq") {

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'NANOPORE_BARCODE01',
                    fastq: file("${projectDir}/assets/reads/sample_ont_part1.fastq", checkIfExists: true)
                ))
                input[1] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("nanopore - fastq - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of(record(
                    id: 'NANOPORE_BARCODE01',
                    fastq: file("${projectDir}/assets/reads/sample_ont_part1.fastq", checkIfExists: true)
                ))
                input[1] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
