/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nextflow.config — defaults, manifest, and profiles
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

plugins {
    id 'nf-schema@2.2.0'   // CLI/parameter + samplesheet validation
}

params {
    // Core inputs
    input  = null          // path to a CSV samplesheet (see assets/samplesheet.csv)
    outdir = 'results'

    // Generic
    help                = false
    publish_dir_mode    = 'copy'
    validate_params     = true
    monochrome_logs     = false   // strip ANSI colours from the completion summary

    // Per-task resource limits (process.resourceLimits in conf/base.config).
    // Raise them on a larger host: --max_cpus 64 --max_memory 256.GB
    max_cpus   = 14
    max_memory = 30.GB
}

// ---------------------------------------------------------------------------
// Container registry — bare image names in modules resolve against this.
// ---------------------------------------------------------------------------
docker.registry    = 'quay.io'
podman.registry    = 'quay.io'
singularity.registry = 'quay.io'
apptainer.registry = 'quay.io'

profiles {
    debug {
        cleanup = false
        process.beforeScript = 'echo $HOSTNAME'
    }
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g) --shm-size=8g'
        conda.enabled       = false
        singularity.enabled = false
        apptainer.enabled   = false
        podman.enabled      = false
    }
    apptainer {
        apptainer.enabled   = true
        apptainer.autoMounts = true
        docker.enabled      = false
        conda.enabled       = false
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled      = false
        conda.enabled       = false
    }
    podman {
        podman.enabled      = true
        podman.runOptions   = '--shm-size=8g'
        docker.enabled      = false
        conda.enabled       = false
    }
    conda {
        conda.enabled       = true
        docker.enabled      = false
        singularity.enabled = false
        apptainer.enabled   = false
    }

    // --- Hardware tiers (set the per-task resource limits) ---
    laptop      { params.max_cpus = 6;  params.max_memory = 12.GB }
    workstation { params.max_cpus = 16; params.max_memory = 60.GB }
    server      { params.max_cpus = 32; params.max_memory = 120.GB }
    hpc         { params.max_cpus = 64; params.max_memory = 256.GB }

    // --- Test data profiles ---
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
}

// Base resource labels and per-module settings. Included after the profiles so
// the resource limits read the max_cpus / max_memory a profile or the CLI sets.
includeConfig 'conf/base.config'
includeConfig 'conf/modules/prepare_reads.config'
includeConfig 'conf/modules/example.config'

// Provenance / reporting.
timeline { enabled = true; file = "${params.outdir}/workflow_info/execution_timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/workflow_info/execution_report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/workflow_info/execution_trace.txt";      overwrite = true }
dag      { enabled = true; file = "${params.outdir}/workflow_info/workflow_dag.html";        overwrite = true }

manifest {
    name            = 'nextflow-template'
    author          = 'Erdi Kılıç'
    homePage        = 'https://github.com/erdikilic/nextflow-template'
    description     = 'A state-of-the-art Nextflow DSL2 workflow template.'
    mainScript      = 'main.nf'
    nextflowVersion = '>=26.04.4'
    version         = '1.0.0dev'
    license         = 'Apache-2.0'
}
