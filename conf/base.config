/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    conf/base.config — default resource requests per process label
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Resource labels cap parallelism at max_cpus / max_memory via [N, cap].min().
    The laptop/workstation/server/hpc profiles in nextflow.config override the
    ceilings per host class. max_cpus/max_memory are statically typed
    (Integer / MemoryUnit) in main.nf, so the min() comparisons stay numeric for
    both defaults and CLI overrides. On retry, memory bumps to the cap once rather
    than multiplying, so it never escalates past the budget on small hosts.

    Default tiers (no profile, max_cpus=14, max_memory=30.GB):
      process_single (1 CPU, 4GB)   process_low    (4 CPU, 8GB)  — e.g. HANDLE_DATA
      process_medium (8 CPU, 16GB)  process_high  (12 CPU, 24GB)
*/

process {
    cpus   = { [4, params.max_cpus].min() }
    memory = { task.attempt == 1 ? [8.GB, params.max_memory].min() : params.max_memory }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = 1
        memory = { task.attempt == 1 ? [4.GB, params.max_memory].min() : params.max_memory }
    }
    withLabel: process_low {
        cpus   = { [4, params.max_cpus].min() }
        memory = { task.attempt == 1 ? [8.GB, params.max_memory].min() : params.max_memory }
    }
    withLabel: process_medium {
        cpus   = { [8, params.max_cpus].min() }
        memory = { task.attempt == 1 ? [16.GB, params.max_memory].min() : params.max_memory }
    }
    withLabel: process_high {
        cpus   = { [12, params.max_cpus].min() }
        memory = { task.attempt == 1 ? [24.GB, params.max_memory].min() : params.max_memory }
    }
    withLabel: error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 3
    }
}
